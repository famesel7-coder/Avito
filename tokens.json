{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {"name": "Avito presentation system", "version": "1.1.0", "canvas": "1920x1080"},
  "color": {
    "ink": {"$value": "#1A1A1A", "$type": "color"},
    "canvas": {"$value": "#F4F4F4", "$type": "color"},
    "surface": {"$value": "#FFFFFF", "$type": "color"},
    "deepGreen": {"$value": "#023915", "$type": "color"},
    "forestGreen": {"$value": "#045A26", "$type": "color"},
    "brandGreen": {"$value": "#00AA4F", "$type": "color"},
    "neonGreen": {"$value": "#0ADA6B", "$type": "color"},
    "mint": {"$value": "#B8EDCF", "$type": "color"},
    "cyan": {"$value": "#00AAFF", "$type": "color"},
    "violet": {"$value": "#A855F7", "$type": "color"},
    "coral": {"$value": "#FF6163", "$type": "color"},
    "orange": {"$value": "#F8A369", "$type": "color"},
    "error": {"$value": "#FF3B30", "$type": "color"}
